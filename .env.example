# Public Supabase configuration for the Angular build/runtime.
# Do not put service_role or secret keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional backwards-compatible name for older local setups.
SUPABASE_ANON_KEY=
# The Supabase Auth user allowed to use the admin area for this deployment.
SUPABASE_ADMIN_USER_ID=
# Optional Web3Forms public access key for contact panel direct submission (https://web3forms.com).
WEB3FORMS_ACCESS_KEY=
# Optional White-Label runtime identity overrides.
PORTFOLIO_AUTHOR_NAME=
PORTFOLIO_BRAND_INITIALS=
PORTFOLIO_PROFILE_ID=
PORTFOLIO_PROFILE_IMAGE_URL=
